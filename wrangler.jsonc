// Cloudflare deploy config for karman.day.
// One Worker serves the static game (./web) and the stats API (/api/*).
// The D1 database has no id on purpose: the first `wrangler deploy` creates a
// database called "karman" and links it (automatic provisioning). The Worker
// creates its own tables on first use, so there is no schema step.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "karman",
  "main": "api/src/index.js",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  // Public values (the Google Client ID is not a secret). Stripe keys and
  // SESSION_SECRET are set as secrets in the Cloudflare dashboard, never here.
  "vars": { "GOOGLE_CLIENT_ID": "356308228840-6jim0vk3hpq8c3abg07hajgmt3lb9ege.apps.googleusercontent.com", "PRICE_CENTS": 599 },
  // Per-IP limit for the anonymous write endpoints (/api/hit, /api/event,
  // /api/report, /api/result): 30 requests a minute per IP and endpoint, counted
  // per Cloudflare location. The Worker fails open if the binding is missing or
  // errors. Needs Wrangler 4.36 or later.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "LIMITER_WIDE", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  // Workers Logs: keeps the Worker's own console.warn / console.error lines
  // (searchable for a few days in the Cloudflare dashboard → Workers → karman →
  // Logs). Per-request invocation logs are off: they'd only add volume and
  // request details we don't need. Free plan: 200,000 log lines a day, and
  // past that Cloudflare simply stops keeping them (no charge).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "d1_databases": [
    { "binding": "DB", "database_name": "karman" }
  ],
  "routes": [
    { "pattern": "karman.day", "custom_domain": true },
    { "pattern": "www.karman.day", "custom_domain": true }
  ]
}
